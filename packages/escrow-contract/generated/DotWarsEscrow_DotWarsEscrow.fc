    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'oracle, $self'treasury, $self'matches) = $DotWarsEscrow$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    var op = in_msg~load_opcode_internal();
    ;; Receive OpenMatch message
    if (op == 0x4f50454e) {
        var $msg'matchId = in_msg~load_uint(256);
        var $msg'host = in_msg~load_msg_addr();
        var $msg'stake = in_msg~load_varuint16();
